OPENPROJECT_URL=https://openproject.lazy247.space
# Optional for legacy OAuth accounts. New accounts use per-user API tokens entered
# through op-discord-admin on the server; /link and /oauth/callback are disabled.
PUBLIC_URL=
OPENPROJECT_CLIENT_ID=
OPENPROJECT_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Required: bot operates in exactly one server and one private-channel category.
DISCORD_GUILD_ID=
DISCORD_CATEGORY_ID=
# Generate using the command in README. Keep stable and back up separately.
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=data/bridge.sqlite3
POLL_INTERVAL_SECONDS=60
MAX_NOTIFICATION_PAGES=100
DELIVERY_BATCH_SIZE=20
HTTP_PORT=8080
# Compose host-side listener; keep 127.0.0.1 for local development.
# A public ingress is only needed for health monitoring; OAuth routes are disabled.
# On the OpenProject host, the existing route uses 192.168.1.12 and 8081.
BRIDGE_BIND_ADDRESS=127.0.0.1
BRIDGE_PUBLISHED_PORT=8080
# Only for compose.tunnel.yaml if the existing cloudflared runs in Docker:
CLOUDFLARE_TUNNEL_NETWORK=
