OPENPROJECT_URL=https://openproject.lazy247.space
# A separate HTTPS hostname routed to this service, with no trailing path.
# Current hostname; its route on the existing Cloudflare Tunnel was verified.
PUBLIC_URL=https://oponproject-bot.lazy247.space
OPENPROJECT_CLIENT_ID=
OPENPROJECT_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Optional: scope slash commands to a test guild for immediate registration.
DISCORD_GUILD_ID=
# Generate using the command in README. Keep stable and back up separately.
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=data/bridge.sqlite3
POLL_INTERVAL_SECONDS=60
MAX_NOTIFICATION_PAGES=100
DELIVERY_BATCH_SIZE=20
HTTP_PORT=8080
# Compose host-side listener; keep 127.0.0.1 for local development.
# On the OpenProject host, set 192.168.1.12 and 8081 for the Cloudflare Tunnel route.
BRIDGE_BIND_ADDRESS=127.0.0.1
BRIDGE_PUBLISHED_PORT=8080
# Only for compose.tunnel.yaml if the existing cloudflared runs in Docker:
CLOUDFLARE_TUNNEL_NETWORK=
