OPENPROJECT_URL=https://openproject.lazy247.space
# Only used by legacy OAuth/channel accounts; DM linkage needs no user token.
# /link and /oauth/callback are disabled.
PUBLIC_URL=
OPENPROJECT_CLIENT_ID=
OPENPROJECT_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Required: bot operates in exactly one Discord server.
DISCORD_GUILD_ID=
# Only required in legacy channel mode.
DISCORD_CATEGORY_ID=
# Generate using the command in README. Keep stable and back up separately.
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=data/bridge.sqlite3
POLL_INTERVAL_SECONDS=60
MAX_NOTIFICATION_PAGES=100
DELIVERY_BATCH_SIZE=20
HTTP_PORT=8080
# webhook_dm sends Discord DMs; channel keeps the previous polling/channel flow.
DELIVERY_MODE=webhook_dm
# Match the secret in OpenProject Admin > API and webhooks. At least 32 characters.
OPENPROJECT_WEBHOOK_SECRET=
# Keep false until the service account and pilot recipients are verified.
MULTI_RECIPIENT_ENABLED=false
# Required if WATCHERS_ENABLED=true. Service account needs view work package watchers.
OPENPROJECT_SERVICE_API_KEY=
MAX_RECIPIENTS_PER_EVENT=50
WATCHERS_ENABLED=false
# Optional comma-separated OpenProject project IDs for a small rollout; empty means all.
WATCHER_PROJECT_IDS=
# Group fanout is independent of Watchers. The service account needs manage_members
# in at least one OpenProject project to read Group members.
GROUPS_ENABLED=false
# Optional comma-separated project IDs. Group tasks outside this list stay unresolved.
GROUP_PROJECT_IDS=
# Master gate for optional Accountable rules in the LAN manager page; default off.
ACCOUNTABLE_ENABLED=false
# Optional Stage E notices. DETAIL requires MULTI_RECIPIENT_ENABLED=true.
DETAIL_NOTIFICATIONS_ENABLED=false
# Attachments require service API read access to task and attachment collection.
ATTACHMENT_NOTIFICATIONS_ENABLED=false
# Reminders need service API access to task, status and configured recipient roles.
REMINDERS_ENABLED=false
REMINDER_HOUR=9
# Defaults for linked users; /op notify can override when enabled.
NOTIFICATION_MODE=instant
DIGEST_HOUR=17
# Optional quiet interval in Asia/Ho_Chi_Minh; set both or leave both empty.
QUIET_START=
QUIET_END=
USER_PREFERENCES_ENABLED=true
# Polling fallback defaults to 300 seconds when Watchers are enabled. Set 0 to disable.
# WATCHER_RECONCILE_SECONDS=300
# Compose host-side listener; keep 127.0.0.1 for local development.
# OpenProject must reach this listener for webhook delivery.
# On the existing host, use 192.168.1.12 and 8081.
BRIDGE_BIND_ADDRESS=127.0.0.1
BRIDGE_PUBLISHED_PORT=8080
# LAN-only manager page; use the same IP and port as the published bridge listener.
ADMIN_URL=http://192.168.1.12:8081
# Only for compose.tunnel.yaml if the existing cloudflared runs in Docker:
CLOUDFLARE_TUNNEL_NETWORK=
