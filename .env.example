OPENPROJECT_URL=https://openproject.lazy247.space
# Only used by legacy OAuth/channel accounts; DM linkage needs no user token.
# /link and /oauth/callback are disabled.
PUBLIC_URL=
OPENPROJECT_CLIENT_ID=
OPENPROJECT_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Required: bot operates in exactly one Discord server.
DISCORD_GUILD_ID=
# Only required in legacy channel mode.
DISCORD_CATEGORY_ID=
# Generate using the command in README. Keep stable and back up separately.
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=data/bridge.sqlite3
POLL_INTERVAL_SECONDS=60
MAX_NOTIFICATION_PAGES=100
DELIVERY_BATCH_SIZE=20
HTTP_PORT=8080
# webhook_dm sends Discord DMs; channel keeps the previous polling/channel flow.
DELIVERY_MODE=webhook_dm
# Match the secret in OpenProject Admin > API and webhooks. At least 32 characters.
OPENPROJECT_WEBHOOK_SECRET=
# Compose host-side listener; keep 127.0.0.1 for local development.
# OpenProject must reach this listener for webhook delivery.
# On the existing host, use 192.168.1.12 and 8081.
BRIDGE_BIND_ADDRESS=127.0.0.1
BRIDGE_PUBLISHED_PORT=8080
# Only for compose.tunnel.yaml if the existing cloudflared runs in Docker:
CLOUDFLARE_TUNNEL_NETWORK=
